# Copiar a .env y completar

DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (MySQL de Wamp)
DB_NAME=ferreteria_pos
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Datos que salen impresos en la boleta
NEGOCIO_NOMBRE=Ferretería
NEGOCIO_RUC=
NEGOCIO_DIRECCION=
NEGOCIO_TELEFONO=

# Serie del ticket interno (el que se imprime sin pasar por SUNAT)
SERIE_TICKET=T001

# Facturacion electronica: RUC, certificado, clave SOL y series B001/F001
# se cargan en /admin > Configuraciones SUNAT, no aqui.
# Token de apis.net.pe para autocompletar cliente por DNI/RUC (opcional)
APIS_NET_PE_TOKEN=
